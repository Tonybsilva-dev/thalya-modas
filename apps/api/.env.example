# Swagger Config
API_BASE_URL=""
API_DEV_URL=""
API_STAGING_URL=""
API_PRODUCTION_URL=""
API_CONTACT_NAME=""
API_CONTACT_EMAIL=""
API_CONTACT_URL=""
API_LICENSE_NAME=""
API_LICENSE_URL=""
API_TERMS_OF_SERVICE=""
API_EXTERNAL_DOCS_URL=""
API_EXTERNAL_DOCS_DESCRIPTION=""

# Auth Config

JWT_SECRET=""
JWT_EXPIRES_IN=""

# Browser clients allowed to call the API in production (comma-separated)
CORS_ORIGINS="http://localhost:3001"

# Persistence - PostgreSQL compartilhado do TrinketOS (desenvolvimento local)
PERSISTENCE_DRIVER="postgres"
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/store-flow?schema=public"
SEED_PREVIEW_USER_ENABLED="false"

# Object storage / Cloudflare R2
R2_ENDPOINT=""
R2_ACCESS_KEY=""
R2_SECRET_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# Catalog feature flags
FEATURE_AUTH_LOGIN_ENABLED="true"
FEATURE_AUTH_REGISTER_ENABLED="true"
FEATURE_AUTH_SSO_ENABLED="false"
FEATURE_CATALOG_ENABLED="true"
FEATURE_ONBOARDING_ENABLED="true"
FEATURE_PASSWORD_RECOVERY_ENABLED="true"
FEATURE_PASSWORD_RECOVERY_REQUEST_ENABLED="true"
FEATURE_PASSWORD_RECOVERY_VERIFY_CODE_ENABLED="true"
FEATURE_PASSWORD_RECOVERY_RESEND_CODE_ENABLED="true"
FEATURE_PASSWORD_RECOVERY_RESET_ENABLED="true"

# Protected dashboard feature flags
FEATURE_DASHBOARD_ENABLED="true"
FEATURE_DASHBOARD_OVERVIEW_ENABLED="true"
FEATURE_DASHBOARD_ORDERS_ENABLED="true"
FEATURE_DASHBOARD_INVENTORY_ENABLED="true"
FEATURE_DASHBOARD_CUSTOMERS_ENABLED="true"
FEATURE_DASHBOARD_CASH_REGISTER_ENABLED="true"
FEATURE_DASHBOARD_SUPPLIERS_ENABLED="true"
FEATURE_DASHBOARD_REPORTS_ENABLED="true"

# Server Config
HOST="0.0.0.0"
PORT="3333"
NODE_ENV="development"

# Revogacao de sessoes e controle de tentativas.
REDIS_URL=redis://127.0.0.1:6379
TRUST_PROXY=false
