generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  passwordHash  String   @map("password_hash")
  role          String
  accountStatus String   @map("account_status")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  ownedTenants             Tenant[]
  tenantMemberships        TenantMembership[]
  stores                   Store[]
  onboardings              Onboarding[]
  passwordRecoveryRequests PasswordRecoveryRequest[]
  suppliers                Supplier[]
  supplierResponsibles     SupplierResponsible[]
  products                 Product[]
  productImageAssets       ProductImageAsset[]
  inventoryMovements       InventoryMovement[]
  purchaseOrders           PurchaseOrder[]
  purchaseOrderItems       PurchaseOrderItem[]
  receivings               Receiving[]
  storeMemberships         StoreMembership[]

  @@map("users")
}

model Tenant {
  planId           String             @default("00000000-0000-4000-8000-000000000001") @map("plan_id")
  plan             Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  featureOverrides Json               @default("{}") @map("feature_overrides")
  id               String             @id @default(uuid())
  ownerId          String             @map("owner_id")
  name             String
  slug             String             @unique
  status           String             @default("ACTIVE")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  owner            User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  stores           Store[]
  memberships      TenantMembership[]

  @@index([ownerId])
  @@map("tenants")
}

model Plan {
  id          String   @id @default(uuid())
  name        String
  description String   @default("")
  status      String   @default("DRAFT")
  priceCents  Int?     @map("price_cents")
  flags       Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  tenants     Tenant[]

  @@map("plans")
}

model PlatformControls {
  id           String   @id @default("global")
  disabledKeys String[] @default([]) @map("disabled_keys")
  maintenance  Boolean  @default(false)
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("platform_controls")
}

model PlanAudit {
  id        String   @id @default(uuid())
  actorId   String   @map("actor_id")
  action    String
  targetId  String   @map("target_id")
  reason    String
  changes   Json
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("plan_audit")
}

model TenantMembership {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  userId    String   @map("user_id")
  role      String
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId, status])
  @@map("tenant_memberships")
}

model Store {
  tenantId    String   @map("tenant_id")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  id          String   @id @default(uuid())
  ownerId     String   @map("owner_id")
  name        String
  slug        String   @unique
  bucketKey   String   @unique @map("bucket_key")
  phone       String
  document    String   @unique
  segment     String
  address     Json?
  preferences Json?
  status      String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  customers            Customer[]
  sales                SaleOrder[]
  cashSessions         CashSession[]
  owner                User                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  onboardings          Onboarding[]
  memberships          StoreMembership[]
  suppliers            Supplier[]
  supplierResponsibles SupplierResponsible[]
  products             Product[]
  productImageAssets   ProductImageAsset[]
  inventoryMovements   InventoryMovement[]
  purchaseOrders       PurchaseOrder[]
  purchaseOrderItems   PurchaseOrderItem[]
  receivings           Receiving[]

  @@index([tenantId])
  @@index([ownerId])
  @@map("stores")
}

model StoreMembership {
  id        String   @id @default(uuid())
  storeId   String   @map("store_id")
  userId    String   @map("user_id")
  role      String
  status    String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storeId, userId])
  @@index([userId, status])
  @@map("store_memberships")
}

model Onboarding {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  storeId        String?  @map("store_id")
  status         String
  nextStep       String   @map("next_step")
  completedSteps String[] @default([]) @map("completed_steps")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store? @relation(fields: [storeId], references: [id], onDelete: SetNull)

  @@unique([userId])
  @@index([storeId])
  @@map("onboardings")
}

model PasswordRecoveryRequest {
  id                  String    @id @default(uuid())
  email               String
  userId              String    @map("user_id")
  code                String
  codeExpiresAt       DateTime  @map("code_expires_at")
  resetToken          String?   @unique @map("reset_token")
  resetTokenExpiresAt DateTime? @map("reset_token_expires_at")
  invalidAttempts     Int       @default(0) @map("invalid_attempts")
  resendAvailableAt   DateTime  @map("resend_available_at")
  status              String
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([userId])
  @@map("password_recovery_requests")
}

model Supplier {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  storeId      String   @map("store_id")
  name         String
  category     String?
  document     String?
  deliveryTerm String?  @map("delivery_term")
  email        String?
  minimumOrder String?  @map("minimum_order")
  notes        String?
  paymentTerm  String?  @map("payment_term")
  phone        String?
  status       String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  store          Store                 @relation(fields: [storeId], references: [id], onDelete: Cascade)
  responsibles   SupplierResponsible[]
  products       Product[]
  purchaseOrders PurchaseOrder[]
  receivings     Receiving[]

  @@unique([storeId, document])
  @@index([userId])
  @@index([storeId])
  @@map("suppliers")
}

model SupplierResponsible {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  storeId     String   @map("store_id")
  supplierId  String   @map("supplier_id")
  name        String
  role        String
  phone       String
  email       String
  contactType String   @map("contact_type")
  isPrimary   Boolean  @default(false) @map("is_primary")
  status      String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  store    Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([storeId])
  @@index([supplierId])
  @@map("supplier_responsibles")
}

model Product {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  storeId          String   @map("store_id")
  supplierId       String?  @map("supplier_id")
  name             String
  sku              String
  barcode          String?
  description      String?
  inventoryControl String   @default("tracked") @map("inventory_control")
  costPrice        Decimal? @map("cost_price") @db.Decimal(12, 2)
  salePrice        Decimal? @map("sale_price") @db.Decimal(12, 2)
  currentStock     Int      @default(0) @map("current_stock")
  minimumStock     Int      @default(0) @map("minimum_stock")
  status           String
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  store              Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  supplier           Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  images             ProductImageAsset[]
  movements          InventoryMovement[]
  purchaseOrderItems PurchaseOrderItem[]

  @@unique([storeId, sku])
  @@unique([storeId, barcode])
  @@index([userId])
  @@index([storeId])
  @@index([supplierId])
  @@map("products")
}

model ProductImageAsset {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  storeId     String   @map("store_id")
  productId   String   @map("product_id")
  fileName    String   @map("file_name")
  contentType String   @map("content_type")
  key         String
  publicUrl   String?  @map("public_url")
  size        Int
  createdAt   DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([storeId])
  @@index([productId])
  @@map("product_image_assets")
}

model InventoryMovement {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  storeId       String   @map("store_id")
  productId     String   @map("product_id")
  type          String
  quantity      Int
  previousStock Int      @map("previous_stock")
  currentStock  Int      @map("current_stock")
  reason        String
  createdAt     DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([storeId])
  @@index([productId])
  @@map("inventory_movements")
}

model PurchaseOrder {
  id                 String   @id @default(uuid())
  userId             String   @map("user_id")
  storeId            String   @map("store_id")
  supplierId         String   @map("supplier_id")
  code               String
  expectedDeliveryAt DateTime @map("expected_delivery_at")
  invoiceNumber      String?  @map("invoice_number")
  notes              String?
  paymentTerm        String?  @map("payment_term")
  status             String
  totalCost          Decimal  @map("total_cost") @db.Decimal(14, 2)
  totalItems         Int      @map("total_items")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  store      Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  supplier   Supplier            @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  items      PurchaseOrderItem[]
  receivings Receiving[]

  @@unique([storeId, code])
  @@index([userId])
  @@index([storeId])
  @@index([supplierId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String  @id @default(uuid())
  userId          String  @map("user_id")
  storeId         String  @map("store_id")
  purchaseOrderId String  @map("purchase_order_id")
  productId       String? @map("product_id")
  name            String
  sku             String
  quantity        Int
  unitCost        Decimal @map("unit_cost") @db.Decimal(12, 2)
  totalCost       Decimal @map("total_cost") @db.Decimal(14, 2)

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  store         Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([storeId])
  @@index([purchaseOrderId])
  @@index([productId])
  @@map("purchase_order_items")
}

model Receiving {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  storeId         String    @map("store_id")
  supplierId      String    @map("supplier_id")
  purchaseOrderId String?   @map("purchase_order_id")
  invoiceNumber   String    @map("invoice_number")
  expectedAt      DateTime  @map("expected_at")
  receivedAt      DateTime? @map("received_at")
  volumes         Int
  dock            String?
  receiverName    String?   @map("receiver_name")
  discrepancies   String?
  status          String
  itemsCount      Int       @map("items_count")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  store         Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  supplier      Supplier       @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([storeId])
  @@index([supplierId])
  @@index([purchaseOrderId])
  @@map("receivings")
}

model Customer {
  id String @id @default(uuid())
  storeId String @map("store_id")
  name String
  email String?
  phone String?
  document String?
  notes String?
  status String @default("ACTIVE")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  @@unique([storeId, document])
  @@index([storeId, name])
  @@map("customers")
}

model SaleOrder {
  id String @id @default(uuid())
  storeId String @map("store_id")
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade, map: "sale_orders_store_fk")
  customerId String? @map("customer_id")
  customerName String? @map("customer_name")
  userId String @map("user_id")
  requestKey String @map("request_key")
  requestHash String @map("request_hash")
  totalCents Int @map("total_cents")
  status String @default("COMPLETED")
  notes String?
  cancelledBy String? @map("cancelled_by")
  cancelledAt DateTime? @map("cancelled_at")
  cancellationReason String? @map("cancellation_reason")
  createdAt DateTime @default(now()) @map("created_at")
  items SaleItem[]
  installments SaleInstallment[]
  @@unique([storeId, requestKey])
  @@index([storeId, createdAt])
  @@index([storeId, customerId])
  @@map("sale_orders")
}

model SaleItem {
  id String @id @default(uuid())
  orderId String @map("order_id")
  productId String @map("product_id")
  name String
  sku String
  quantity Int
  unitPriceCents Int @map("unit_price_cents")
  tracked Boolean
  order SaleOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  @@index([orderId])
  @@map("sale_items")
}

model SaleInstallment {
  id String @id @default(uuid())
  orderId String @map("order_id")
  number Int
  dueDate String @map("due_date")
  amountCents Int @map("amount_cents")
  paidCents Int @default(0) @map("paid_cents")
  order SaleOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payments SalePayment[]
  @@unique([orderId, number])
  @@map("sale_installments")
}

model SalePayment {
  id String @id @default(uuid())
  installmentId String @map("installment_id")
  cashSessionId String @map("cash_session_id")
  userId String @map("user_id")
  requestKey String @map("request_key")
  amountCents Int @map("amount_cents")
  method String
  createdAt DateTime @default(now()) @map("created_at")
  installment SaleInstallment @relation(fields: [installmentId], references: [id], onDelete: Cascade)
  cashSession CashSession @relation(fields: [cashSessionId], references: [id])
  @@unique([cashSessionId, requestKey])
  @@map("sale_payments")
}

model CashSession {
  id String @id @default(uuid())
  storeId String @map("store_id")
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade, map: "cash_sessions_store_fk")
  openedBy String @map("opened_by")
  closedBy String? @map("closed_by")
  openingCents Int @map("opening_cents")
  countedCents Int? @map("counted_cents")
  expectedCents Int? @map("expected_cents")
  notes String?
  openedAt DateTime @default(now()) @map("opened_at")
  closedAt DateTime? @map("closed_at")
  movements CashMovement[]
  payments SalePayment[]
  @@index([storeId, openedAt])
  @@map("cash_sessions")
}

model CashMovement {
  id String @id @default(uuid())
  cashSessionId String @map("cash_session_id")
  userId String @map("user_id")
  requestKey String @map("request_key")
  amountCents Int @map("amount_cents")
  kind String
  reason String
  createdAt DateTime @default(now()) @map("created_at")
  cashSession CashSession @relation(fields: [cashSessionId], references: [id], onDelete: Cascade)
  @@unique([cashSessionId, requestKey])
  @@map("cash_movements")
}
