generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  passwordHash  String   @map("password_hash")
  role          String
  accountStatus String   @map("account_status")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  stores                   Store[]
  onboardings              Onboarding[]
  passwordRecoveryRequests PasswordRecoveryRequest[]
  suppliers                Supplier[]
  supplierResponsibles     SupplierResponsible[]
  products                 Product[]
  productImageAssets       ProductImageAsset[]
  inventoryMovements       InventoryMovement[]
  purchaseOrders           PurchaseOrder[]
  purchaseOrderItems       PurchaseOrderItem[]
  receivings               Receiving[]
  storeMemberships         StoreMembership[]

  @@map("users")
}

model Store {
  id          String   @id @default(uuid())
  ownerId     String   @map("owner_id")
  name        String
  slug        String   @unique
  bucketKey   String   @unique @map("bucket_key")
  phone       String
  document    String   @unique
  segment     String
  address     Json?
  preferences Json?
  status      String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  owner                User                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  onboardings          Onboarding[]
  memberships          StoreMembership[]
  suppliers            Supplier[]
  supplierResponsibles SupplierResponsible[]
  products             Product[]
  productImageAssets   ProductImageAsset[]
  inventoryMovements   InventoryMovement[]
  purchaseOrders       PurchaseOrder[]
  purchaseOrderItems   PurchaseOrderItem[]
  receivings           Receiving[]

  @@index([ownerId])
  @@map("stores")
}

model StoreMembership {
  id        String   @id @default(uuid())
  storeId   String   @map("store_id")
  userId    String   @map("user_id")
  role      String
  status    String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storeId, userId])
  @@index([userId, status])
  @@map("store_memberships")
}

model Onboarding {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  storeId        String?  @map("store_id")
  status         String
  nextStep       String   @map("next_step")
  completedSteps String[] @default([]) @map("completed_steps")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store? @relation(fields: [storeId], references: [id], onDelete: SetNull)

  @@unique([userId])
  @@index([storeId])
  @@map("onboardings")
}

model PasswordRecoveryRequest {
  id                  String    @id @default(uuid())
  email               String
  userId              String    @map("user_id")
  code                String
  codeExpiresAt       DateTime  @map("code_expires_at")
  resetToken          String?   @unique @map("reset_token")
  resetTokenExpiresAt DateTime? @map("reset_token_expires_at")
  invalidAttempts     Int       @default(0) @map("invalid_attempts")
  resendAvailableAt   DateTime  @map("resend_available_at")
  status              String
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([userId])
  @@map("password_recovery_requests")
}

model Supplier {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  storeId      String   @map("store_id")
  name         String
  category     String?
  document     String?
  deliveryTerm String?  @map("delivery_term")
  email        String?
  minimumOrder String?  @map("minimum_order")
  notes        String?
  paymentTerm  String?  @map("payment_term")
  phone        String?
  status       String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  store          Store                 @relation(fields: [storeId], references: [id], onDelete: Cascade)
  responsibles   SupplierResponsible[]
  products       Product[]
  purchaseOrders PurchaseOrder[]
  receivings     Receiving[]

  @@unique([storeId, document])
  @@index([userId])
  @@index([storeId])
  @@map("suppliers")
}

model SupplierResponsible {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  storeId     String   @map("store_id")
  supplierId  String   @map("supplier_id")
  name        String
  role        String
  phone       String
  email       String
  contactType String   @map("contact_type")
  isPrimary   Boolean  @default(false) @map("is_primary")
  status      String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  store    Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([storeId])
  @@index([supplierId])
  @@map("supplier_responsibles")
}

model Product {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  storeId      String   @map("store_id")
  supplierId   String?  @map("supplier_id")
  name         String
  sku          String
  description  String?
  costPrice    Decimal? @map("cost_price") @db.Decimal(12, 2)
  salePrice    Decimal? @map("sale_price") @db.Decimal(12, 2)
  currentStock Int      @default(0) @map("current_stock")
  minimumStock Int      @default(0) @map("minimum_stock")
  status       String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  store              Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  supplier           Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  images             ProductImageAsset[]
  movements          InventoryMovement[]
  purchaseOrderItems PurchaseOrderItem[]

  @@unique([storeId, sku])
  @@index([userId])
  @@index([storeId])
  @@index([supplierId])
  @@map("products")
}

model ProductImageAsset {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  storeId     String   @map("store_id")
  productId   String   @map("product_id")
  fileName    String   @map("file_name")
  contentType String   @map("content_type")
  key         String
  publicUrl   String?  @map("public_url")
  size        Int
  createdAt   DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([storeId])
  @@index([productId])
  @@map("product_image_assets")
}

model InventoryMovement {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  storeId       String   @map("store_id")
  productId     String   @map("product_id")
  type          String
  quantity      Int
  previousStock Int      @map("previous_stock")
  currentStock  Int      @map("current_stock")
  reason        String
  createdAt     DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([storeId])
  @@index([productId])
  @@map("inventory_movements")
}

model PurchaseOrder {
  id                 String   @id @default(uuid())
  userId             String   @map("user_id")
  storeId            String   @map("store_id")
  supplierId         String   @map("supplier_id")
  code               String
  expectedDeliveryAt DateTime @map("expected_delivery_at")
  invoiceNumber      String?  @map("invoice_number")
  notes              String?
  paymentTerm        String?  @map("payment_term")
  status             String
  totalCost          Decimal  @map("total_cost") @db.Decimal(14, 2)
  totalItems         Int      @map("total_items")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  store      Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  supplier   Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  items      PurchaseOrderItem[]
  receivings Receiving[]

  @@unique([storeId, code])
  @@index([userId])
  @@index([storeId])
  @@index([supplierId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String  @id @default(uuid())
  userId          String  @map("user_id")
  storeId         String  @map("store_id")
  purchaseOrderId String  @map("purchase_order_id")
  productId       String? @map("product_id")
  name            String
  sku             String
  quantity        Int
  unitCost        Decimal @map("unit_cost") @db.Decimal(12, 2)
  totalCost       Decimal @map("total_cost") @db.Decimal(14, 2)

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  store         Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([storeId])
  @@index([purchaseOrderId])
  @@index([productId])
  @@map("purchase_order_items")
}

model Receiving {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  storeId         String    @map("store_id")
  supplierId      String    @map("supplier_id")
  purchaseOrderId String?   @map("purchase_order_id")
  invoiceNumber   String    @map("invoice_number")
  expectedAt      DateTime  @map("expected_at")
  receivedAt      DateTime? @map("received_at")
  volumes         Int
  dock            String?
  receiverName    String?   @map("receiver_name")
  discrepancies   String?
  status          String
  itemsCount      Int       @map("items_count")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  store         Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  supplier      Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([storeId])
  @@index([supplierId])
  @@index([purchaseOrderId])
  @@map("receivings")
}
