{
  "name": "store-flow",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@prisma/client",
      "@prisma/engines",
      "@swc/core",
      "argon2",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver"
    ],
    "ignoredBuiltDependencies": [
      "core-js-pure"
    ]
  },
  "scripts": {
    "dev": "pnpm --filter @store-flow/api dev",
    "dev:api": "pnpm --filter @store-flow/api dev",
    "dev:backoffice": "pnpm --filter @store-flow/backoffice dev --port 3001",
    "dev:docs": "pnpm --filter @store-flow/docs dev",
    "storybook": "pnpm --filter @store-flow/docs storybook",
    "build": "pnpm -r build",
    "build:api": "pnpm --filter @store-flow/api build",
    "build:backoffice": "pnpm --filter @store-flow/backoffice build",
    "build:docs": "pnpm --filter @store-flow/docs build",
    "typecheck": "pnpm -r --if-present typecheck && pnpm -r --if-present build:check",
    "test": "pnpm -r test",
    "test:backoffice": "pnpm --filter @store-flow/api exec tsx --tsconfig ../backoffice/tsconfig.json --import ../backoffice/tests/react-runtime.mjs --test ../backoffice/tests/proxy.test.ts ../backoffice/tests/api-error.test.ts ../backoffice/tests/overview.test.tsx ../backoffice/tests/brl.test.ts ../backoffice/tests/supplier-panel.test.ts",
    "test:coverage": "pnpm -r test:coverage",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format",
    "check": "pnpm -r check",
    "qa": "pnpm -r qa",
    "docker:postgres:up": "docker start as-trinketos-postgres-1",
    "docker:postgres:isolated:up": "docker compose -f docker/compose.yml up -d postgres",
    "docker:postgres:isolated:down": "docker compose -f docker/compose.yml down",
    "docker:postgres:logs": "docker logs -f as-trinketos-postgres-1",
    "db:generate": "pnpm --filter @store-flow/api db:generate",
    "db:migrate": "pnpm --filter @store-flow/api db:migrate",
    "db:deploy": "pnpm --filter @store-flow/api db:deploy",
    "admin:bootstrap": "pnpm --filter @store-flow/api admin:bootstrap",
    "db:studio": "pnpm --filter @store-flow/api db:studio",
    "openapi:generate": "pnpm --filter @store-flow/api openapi:generate",
    "openapi:changes": "pnpm --filter @store-flow/api openapi:changes"
  }
}
